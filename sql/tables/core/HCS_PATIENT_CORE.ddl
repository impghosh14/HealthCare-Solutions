CREATE OR REPLACE TABLE HCS_PATIENT_CORE (
    patient_id STRING,
    visit_id STRING,
    name STRING,
    sex STRING,
    age NUMBER,
    email STRING,
    mobile STRING,
    address STRING,
    city STRING,
    state STRING,
    pincode STRING,
    country STRING,
    weight_kg FLOAT,
    height_cm FLOAT,
    bmi FLOAT,
    bmi_category STRING,
    bp_systolic NUMBER,
    bp_diastolic NUMBER,
    had_surgery BOOLEAN,
    surgery_type STRING,
    hemoglobin_g_dL FLOAT,
    wbc_count_10_3_uL FLOAT,
    rbc_count_10_6_uL FLOAT,
    platelet_count_10_3_uL FLOAT,
    neutrophils_percent FLOAT,
    lymphocytes_percent FLOAT,
    monocytes_percent FLOAT,
    eosinophils_percent FLOAT,
    basophils_percent FLOAT,
    esr_mm_hr FLOAT,
    crp_mg_L FLOAT,
    cholesterol_total_mg_dL FLOAT,
    triglycerides_mg_dL FLOAT,
    hdl_mg_dL FLOAT,
    ldl_mg_dL FLOAT,
    vldl_mg_dL FLOAT,
    non_hdl_mg_dL FLOAT,
    chol_hdl_ratio FLOAT,
    ldl_hdl_ratio FLOAT,
    glucose_fasting_mg_dL FLOAT,
    glucose_pp_mg_dL FLOAT,
    sugar_random_mg_dL FLOAT,
    hba1c_percent FLOAT,
    tsh_uIU_mL FLOAT,
    t3_ng_mL FLOAT,
    t4_ug_dL FLOAT,
    urea_mg_dL FLOAT,
    creatinine_mg_dL FLOAT,
    uric_acid_mg_dL FLOAT,
    gfr_mL_min_1_73m2 FLOAT,
    sodium_mEq_L FLOAT,
    potassium_mEq_L FLOAT,
    chloride_mEq_L FLOAT,
    calcium_mg_dL FLOAT,
    phosphorus_mg_dL FLOAT,
    bilirubin_total_mg_dL FLOAT,
    bilirubin_direct_mg_dL FLOAT,
    bilirubin_indirect_mg_dL FLOAT,
    ast_sgot_U_L FLOAT,
    alt_sgpt_U_L FLOAT,
    alp_U_L FLOAT,
    ggt_U_L FLOAT,
    total_protein_g_dL FLOAT,
    albumin_g_dL FLOAT,
    globulin_g_dL FLOAT,
    ammonia_ug_dL FLOAT,
    amylase_U_L FLOAT,
    lipase_U_L FLOAT,
    serum_iron_ug_dL FLOAT,
    vitamin_d_ng_mL FLOAT,
    vitamin_b12_pg_mL FLOAT,
    urine_ph FLOAT,
    urine_specific_gravity FLOAT,
    urine_protein STRING,
    urine_glucose STRING,
    urine_ketones STRING,
    smoker BOOLEAN,
    alcohol_intake STRING,
    exercise_level STRING,
    diet_type STRING,
    family_history_diabetes BOOLEAN,
    family_history_heart_disease BOOLEAN,
    diabetes_flag BOOLEAN,
    hypertension_flag BOOLEAN,
    cholesterol_flag BOOLEAN,
    renal_impairment_flag BOOLEAN,
    thyroid_disorder_flag BOOLEAN,
    SOURCE_FILE STRING,
    INGESTION_ID STRING,
    INGESTION_TS TIMESTAMP
);
