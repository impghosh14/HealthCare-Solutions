CREATE OR REPLACE TABLE HCS_DOCTOR_CORE (
    Registration_Id STRING,
    Name STRING,
    Specialization STRING,
    Email_Id STRING,
    Mobile_Number STRING,
    Address STRING,
    Graduation_Year NUMBER,
    Graduation_University_Name STRING,
    MD_University_Name STRING,
    Years_of_Experience NUMBER,
    Qualification STRING,
    Working_In STRING,
    Surgery_Count NUMBER,
    Off_Day STRING,
    SOURCE_FILE STRING,
    INGESTION_ID STRING,
    INGESTION_TS TIMESTAMP
);
